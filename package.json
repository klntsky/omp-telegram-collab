{
  "name": "omp-telegram-collab",
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "bin": {
    "omp-telegram-collab": "dist/cli.js"
  },
  "files": [
    "dist/",
    "web/dist/",
    "web/LICENSE.upstream",
    "assets/"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "prepack": "pnpm build",
    "dev": "node --import tsx src/cli.ts start",
    "start": "node dist/cli.js start",
    "cli": "node dist/cli.js",
    "generate:commands": "node scripts/generate-commands.mjs",
    "build": "pnpm generate:commands && tsc --noEmit -p tsconfig.json && node scripts/build.mjs && vite build --config web/vite.config.ts",
    "check": "pnpm generate:commands && tsc --noEmit -p tsconfig.json && tsc --noEmit -p web/tsconfig.json && tsc --noEmit -p tsconfig.verification.json",
    "test": "tsx --test --test-concurrency=5 test/*.test.ts",
    "test:one": "tsx --test --test-concurrency=5",
    "test:integration": "pnpm build && pnpm smoke",
    "verify": "pnpm check && pnpm test && pnpm test:integration",
    "smoke": "tsx scripts/smoke.ts",
    "smoke:cli": "tsx scripts/smoke.ts cli",
    "smoke:telegram": "tsx scripts/smoke.ts telegram",
    "smoke:gateway": "tsx scripts/smoke.ts gateway",
    "smoke:runtime": "tsx scripts/smoke.ts runtime"
  },
  "dependencies": {
    "@lezer/lr": "^1.4.12",
    "@lydell/node-pty": "1.2.0-beta.18",
    "@oh-my-pi/pi-wire": "16.3.6",
    "abort-controller": "^3.0.0",
    "commander": "^15.0.0",
    "grammy": "^1.46.0",
    "katex": "^0.16.22",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ws": "^8.18.0",
    "yaml": "^2.9.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@lezer/generator": "^1.8.1",
    "@types/katex": "^0.16.7",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.14",
    "esbuild": "^0.25.12",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "vite": "^6.4.0"
  }
}
