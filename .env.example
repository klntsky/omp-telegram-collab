# Required for a single bot. Keep real values in .env, not this file.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_USERNAMES=
PUBLIC_URL=

# Optional. Blank values use the defaults documented in README.md.
TELEGRAM_MINI_APP_SHORT_NAME=
TELEGRAM_BOT_NAMES=
HOST=
PORT=
DATA_DIR=
OMP_EXECUTABLE=
OMP_CWD=
OMP_MAX_SESSIONS=
OMP_STARTUP_TIMEOUT_MS=
OMP_RELAY_URL=

# Optional literal OMP arguments, ordered by numeric suffix. No shell parsing.
OMP_ARG_1=
OMP_ARG_2=
